<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TitanEngine.Avalonia.ViewModels"
             x:Class="TitanEngine.Avalonia.Views.Controls.FxStudioView"
             x:DataType="vm:FxStudioViewModel">
  <HeaderedContentControl Header="FX STUDIO" Foreground="{DynamicResource FxHeaderBrush}">
    <StackPanel>
      <TextBlock Text="Effect" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
      <ComboBox ItemsSource="{Binding FxTypeOptions}" SelectedItem="{Binding FxType}" Margin="0,0,0,10" HorizontalAlignment="Stretch">
        <!-- Avalonia 11: ItemContainerStyle không còn — dùng Styles scoped trong ComboBox;
             binding per-item (ComboOption.Enabled) cần reflection → tắt compile cho style này -->
        <ComboBox.Styles>
          <Style x:CompileBindings="False" Selector="ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
            <Setter Property="ToolTip.Tip" Value="chưa hỗ trợ trên bản này"/>
          </Style>
        </ComboBox.Styles>
      </ComboBox>

      <TextBlock Text="Template (CapCut Style)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
      <ComboBox ItemsSource="{Binding TemplateStyleOptions}" SelectedItem="{Binding TemplateStyle}" Margin="0,0,0,10" HorizontalAlignment="Stretch"/>

      <TextBlock Text="Overlay" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
      <StackPanel Margin="0,0,0,12">
        <!-- Overlay đã port bằng SkiaSharp (AvaloniaEngineServices) — bật được, render sẽ sử dụng
             SkiaSharp vẽ overlay thay vì WPF DrawingContext -->
        <CheckBox Content="Overlay 1" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" IsChecked="{Binding SnowOverlay1}"
                  ToolTip.Tip="Overlay đã port SkiaSharp; render sẽ dùng AvaloniaEngineServices"/>
        <CheckBox Content="Overlay 2" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" IsChecked="{Binding SnowOverlay2}"
                  ToolTip.Tip="Overlay đã port SkiaSharp; render sẽ dùng AvaloniaEngineServices"/>
        <CheckBox Content="Overlay 3" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" IsChecked="{Binding SnowOverlay3}"
                  ToolTip.Tip="Overlay đã port SkiaSharp; render sẽ dùng AvaloniaEngineServices"/>
        <CheckBox Content="Overlay Intro" Foreground="{DynamicResource TextSecondaryBrush}" IsChecked="{Binding OverlayIntro}"
                  ToolTip.Tip="Overlay đã port SkiaSharp; render sẽ dùng AvaloniaEngineServices"/>
      </StackPanel>

      <!-- pnlRainOverlaySettings: bản gốc cũng luôn collapsed (không có code nào hiện nó) -->
      <StackPanel IsVisible="False" Margin="0,-4,0,12">
        <TextBlock Text="Rain Preset" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
        <ComboBox ItemsSource="{Binding RainPresetOptions}" SelectedItem="{Binding RainPreset}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
        <TextBlock Text="Rain Intensity" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
        <ComboBox ItemsSource="{Binding RainIntensityOptions}" SelectedItem="{Binding RainIntensity}" Margin="0,0,0,4" HorizontalAlignment="Stretch"/>
        <TextBlock Text="Uses real rain video assets from Assets/Overlays/Rain" Foreground="{DynamicResource TextDisabledBrush}" FontSize="9" TextWrapping="Wrap"/>
      </StackPanel>

      <TextBlock Text="Border" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
      <ComboBox ItemsSource="{Binding BorderTypeOptions}" SelectedItem="{Binding BorderType}" Margin="0,0,0,12" HorizontalAlignment="Stretch">
        <ComboBox.Styles>
          <Style x:CompileBindings="False" Selector="ComboBoxItem">
            <Setter Property="IsEnabled" Value="{Binding Enabled}"/>
            <Setter Property="ToolTip.Tip" Value="chưa hỗ trợ trên bản này"/>
          </Style>
        </ComboBox.Styles>
      </ComboBox>

      <StackPanel IsVisible="{Binding ShowSnowfallOpacity}" Margin="0,-4,0,12">
        <StackPanel IsVisible="{Binding ShowSnowOverlay1Opacity}" Margin="0,0,0,8">
          <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
            <TextBlock Text="Overlay 1 Opacity" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="55%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowSnowOverlay2Opacity}" Margin="0,0,0,8">
          <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
            <TextBlock Text="Overlay 2 Opacity" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="55%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowSnowOverlay3Opacity}" Margin="0,0,0,8">
          <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
            <TextBlock Text="Overlay 3 Opacity" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="55%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowOverlayIntroOpacity}" Margin="0,0,0,8">
          <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
            <TextBlock Text="Intro Opacity" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="100%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding ShowSharedSnowOpacity}" Margin="0,0,0,8">
          <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
            <TextBlock Text="Snow Opacity" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="55%" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
          </Grid>
        </StackPanel>
        <TextBlock Text="Overlay 1, 2, 3, and Intro use separate opacity sliders." Foreground="{DynamicResource TextDisabledBrush}" FontSize="9" TextWrapping="Wrap"/>
      </StackPanel>

      <CheckBox Content="Use TITAN Logo" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-4,0,8" IsChecked="{Binding EnableBrandLogo}"/>

      <TextBlock Text="Logo Position" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
      <ComboBox ItemsSource="{Binding BrandLogoPositionOptions}" SelectedItem="{Binding BrandLogoPosition}" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>

      <TextBlock Text="Intensity" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
      <Slider Minimum="0" Maximum="100" Value="{Binding FxIntensity}" Margin="0,0,0,15"/>

      <TextBlock Text="Magazine Cover Title" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
      <TextBox Text="{Binding MagazineCoverTitle}" Margin="0,0,0,8"/>

      <TextBlock Text="Magazine Cover Subtitle" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
      <TextBox Text="{Binding MagazineCoverSubtitle}" Margin="0,0,0,12"/>

      <TextBlock Text="Crop Zoom (9:16)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
      <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
        <TextBlock Text="Center crop and zoom in automatically" Foreground="{DynamicResource TextDisabledBrush}" FontSize="10"/>
        <TextBlock Grid.Column="1" Text="{Binding CropZoomDisplay}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
      </Grid>
      <Slider Minimum="0" Maximum="80" Value="{Binding CropZoom}" TickFrequency="1" Margin="0,0,0,4"/>
      <TextBlock Text="0% = no crop, 50% = medium zoom crop. Output is kept in 9:16." Foreground="{DynamicResource TextDisabledBrush}" FontSize="10" Margin="0,0,0,12" TextWrapping="Wrap"/>

      <TextBlock Text="Timeline Preview (Phạm vi áp dụng)" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,0,5"/>
      <Border BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" Height="25" Background="{StaticResource TimelinePreviewBgBrush}" Margin="0,0,0,10" CornerRadius="3">
        <Panel x:Name="gridTimelinePreview" Background="{StaticResource TimelinePreviewBgBrush}">
          <Border x:Name="bdrFxRange" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                  Opacity="0.9" CornerRadius="2" Width="0"/>
        </Panel>
      </Border>

      <Grid ColumnDefinitions="*,*">
        <StackPanel Margin="0,0,5,0">
          <TextBlock Text="Start %" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding FxStart}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="5,0,0,0">
          <TextBlock Text="End %" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
          <Slider Minimum="0" Maximum="100" Value="{Binding FxEnd}"/>
        </StackPanel>
      </Grid>

      <Border BorderBrush="{StaticResource FadePanelBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,14,0,0" Background="{StaticResource FadePanelBgBrush}">
        <StackPanel>
          <CheckBox Content="Enable Fade In / Out" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" IsChecked="{Binding EnableFade}"/>
          <Grid ColumnDefinitions="*,12,*">
            <StackPanel>
              <TextBlock Text="Fade In (sec)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
              <TextBox Text="{Binding FadeInSeconds}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Fade Out (sec)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
              <TextBox Text="{Binding FadeOutSeconds}"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </HeaderedContentControl>
</UserControl>
