<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TitanEngine.Avalonia.ViewModels"
             xmlns:core="using:TitanEngine"
             xmlns:conv="using:TitanEngine.Avalonia.Converters"
             x:Class="TitanEngine.Avalonia.Views.Controls.QueueLogsView"
             x:DataType="vm:QueueLogsViewModel">
  <!-- Khu QUEUE + LOGS — mirror cột phải MainWindow.xaml WPF (rows: queue / progress / log / nút). -->
  <Grid RowDefinitions="*,20,180,20,60">

    <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
      <Panel>
        <ListBox x:Name="lstQueue" ItemsSource="{Binding Jobs}" Background="Transparent" BorderThickness="0" Padding="10">
          <!-- Avalonia: DataTemplate không có Styles — style viền accent để ở scope ListBox -->
          <ListBox.Styles>
            <!-- WPF: DataTrigger IsApiJob=True → viền accent -->
            <Style Selector="Border.api">
              <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter Property="BorderThickness" Value="2"/>
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="core:RenderJob">
              <Border Classes.api="{Binding IsApiJob}" Background="{DynamicResource CardBgBrush}" Margin="0,0,0,8" CornerRadius="8" Padding="11"
                      BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Background="{StaticResource QueueBadgeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Id}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ConfigSummary}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border Background="{StaticResource QueueApiBadgeBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="0,0,10,4" HorizontalAlignment="Right" IsVisible="{Binding IsApiJob}">
                      <TextBlock Text="API" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold"/>
                    </Border>
                    <Border Background="{StaticResource QueueBadgeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusColor, Converter={x:Static conv:StatusColorToBrushConverter.Instance}}" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <Button Content="✕" Width="25" Height="25" Background="{StaticResource QueueDeleteButtonBrush}" FontSize="10" ToolTip.Tip="Remove this job"
                            Command="{Binding $parent[ItemsControl].((vm:QueueLogsViewModel)DataContext).DeleteJobCommand}" CommandParameter="{Binding}"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="No jobs yet - drop files or add from the left panel"
                   Foreground="{DynamicResource TextDisabledBrush}" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False" IsVisible="{Binding !HasJobs}"/>
      </Panel>
    </Border>

    <ProgressBar Grid.Row="1" Margin="0,5" Minimum="0" Maximum="100" Value="{Binding GlobalProgress}" Background="{StaticResource TimelinePreviewBgBrush}" BorderThickness="0" Height="10">
      <ProgressBar.Foreground>
        <StaticResource ResourceKey="QueueProgressBrush"/>
      </ProgressBar.Foreground>
    </ProgressBar>

    <Border Grid.Row="2" Background="{StaticResource TimelinePreviewBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
      <Grid RowDefinitions="Auto,*">
        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,0,0"/>
            <TextBlock Text="SYSTEM LOG" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </StackPanel>
        </Border>
        <!-- LogText gom ở root VM (buffer 400 dòng) — binding qua DataContext của Window -->
        <TextBox Grid.Row="1" Background="Transparent" Foreground="{DynamicResource QueueLogTextBrush}" FontFamily="Consolas" FontSize="11"
                 BorderThickness="0" Padding="10" IsReadOnly="True" TextWrapping="Wrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LogText}"/>
      </Grid>
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="130,*,150">
      <Button Content="CLEAR" Margin="0,0,15,0" Background="{DynamicResource ButtonBgBrush}" Command="{Binding ClearCommand}"/>
      <Button Grid.Column="1" Margin="0,0,15,0" Command="{Binding StartBatchCommand}">
        <Button.Background>
          <StaticResource ResourceKey="QueueStartButtonBrush"/>
        </Button.Background>
        <TextBlock Text="{Binding StartButtonText}" FontWeight="Bold" FontSize="14"/>
      </Button>
      <Button Grid.Column="2" Content="{Binding HostButtonText}" Command="{Binding ToggleHostCommand}" Background="{StaticResource QueueHostButtonBgBrush}" BorderBrush="{StaticResource QueueHostButtonBorderBrush}"/>
    </Grid>
  </Grid>
</UserControl>
