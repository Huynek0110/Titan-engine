<Application x:Class="TitanEngine.Avalonia.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Styles>
        <!-- Control styles (port từ WPF MainWindow.xaml — chỉ đổi vỏ, không đổi cấu trúc khu UI) -->
        <!-- HeaderedContentControl (group box của WPF) -->
        <Style Selector="HeaderedContentControl">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeMd}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{TemplateBinding Header}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold" FontSize="{TemplateBinding FontSize}" />
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- ToolTip -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ToolTipBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ToolTipTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSm}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource ToolTipBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,7">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Button -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ButtonPressedBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPressedBorderBrush}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <!-- Button.primary -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#0A0C10" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
        </Style>
        <!-- Button.secondary -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <!-- Button.ghost -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <!-- TextBox -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
        </Style>
        <Style Selector="TextBox:focus:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" />
        </Style>
        <!-- ComboBox -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="11,4,28,4" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            <Setter Property="MaxDropDownHeight" Value="280" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1F2733" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1F4258" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        </Style>
        <!-- CheckBox -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="17" Height="17" CornerRadius="4.5" Background="{DynamicResource InputBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="check" Data="M3.6,8.6 L7,12 L13.4,4.6" Stroke="#0A0C10" StrokeThickness="2.1"
                                  Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
                        </Border>
                        <ContentPresenter x:Name="PART_ContentPresenter" Margin="9,0,0,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#box">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#check">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#box">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- Slider -->
        <Style Selector="Slider">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Background="Transparent" MinHeight="18" VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseButton>
                                <RepeatButton Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="{DynamicResource AccentBrush}" Height="4" CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Ellipse Width="15" Height="15" Fill="{DynamicResource TextPrimaryBrush}"
                                                     Stroke="#0A0C10" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseButton>
                                <RepeatButton Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate>
                                            <Border Background="#242B36" Height="4" CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- TextBlock section-title -->
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="LetterSpacing" Value="0.5" />
        </Style>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <!-- Design tokens -->
            <SolidColorBrush x:Key="WindowBgBrush" Color="#0B0E13" />
            <SolidColorBrush x:Key="PanelBgBrush" Color="#11141A" />
            <SolidColorBrush x:Key="CardBgBrush" Color="#151A21" />
            <SolidColorBrush x:Key="HoverBgBrush" Color="#1B2230" />
            <SolidColorBrush x:Key="BorderBrush" Color="#232B36" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#2D3748" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#1E242E" />
            <SolidColorBrush x:Key="AccentBrush" Color="#4CC3FF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#6FD0FF" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#2FA8E6" />
            <SolidColorBrush x:Key="AccentLightBrush" Color="#2D7FBF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFB84D" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EBF2" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B95A5" />
            <SolidColorBrush x:Key="TextDisabledBrush" Color="#566074" />
            <SolidColorBrush x:Key="InputBrush" Color="#161B22" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#262D38" />
            <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#334050" />
            <SolidColorBrush x:Key="InputFocusBorderBrush" Color="#4CC3FF" />
            <SolidColorBrush x:Key="ButtonBgBrush" Color="#1A202A" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2A3340" />
            <SolidColorBrush x:Key="ButtonHoverBgBrush" Color="#202836" />
            <SolidColorBrush x:Key="ButtonPressedBgBrush" Color="#161B22" />
            <SolidColorBrush x:Key="ButtonPressedBorderBrush" Color="#1F4258" />
            <SolidColorBrush x:Key="ToolTipBrush" Color="#171B23" />
            <SolidColorBrush x:Key="ToolTipTextBrush" Color="#C9D2DE" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#2A3340" />
            <SolidColorBrush x:Key="AccentDimBrush" Color="#1F4258" />
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0E13" />
            <x:Double x:Key="Space2">4</x:Double>
            <x:Double x:Key="Space3">8</x:Double>
            <x:Double x:Key="Space4">12</x:Double>
            <x:Double x:Key="Space5">16</x:Double>
            <x:Double x:Key="Space6">24</x:Double>
            <x:Double x:Key="FontSizeSm">11</x:Double>
            <x:Double x:Key="FontSizeBase">12</x:Double>
            <x:Double x:Key="FontSizeMd">13</x:Double>
            <x:Double x:Key="FontSizeLg">15</x:Double>
            <x:Double x:Key="FontSizeXl">20</x:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
