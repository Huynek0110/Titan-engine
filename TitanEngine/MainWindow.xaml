<Window x:Class="TitanEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TITAN ENGINE V192" Height="900" Width="1200"
        Foreground="White"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">

    <Window.Background>
        <SolidColorBrush Color="#0F1115"/>
    </Window.Background>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B1F26"/>
            <Setter Property="Foreground" Value="#E6E9EF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A3038"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E4A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#00CCFF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005580"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161A20"/>
            <Setter Property="Foreground" Value="#5CE1E6"/>
            <Setter Property="BorderBrush" Value="#2A3038"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#161A20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#2F2F37"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#3D3D48"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="#161A20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2A3038"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#262C34"/>
            <Setter Property="Background" Value="#15181D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2" Background="#0DFFFFFF" CornerRadius="8" BorderBrush="#262C34" BorderThickness="1"/>
                            <Border Grid.Row="0" Background="Transparent" Padding="16,10,0,6">
                                <ContentPresenter ContentSource="Header" TextElement.FontWeight="Bold"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="15,5,15,15"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <Border Width="6" Height="42" CornerRadius="3" Margin="0,0,15,0" Background="#00CCFF"/>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="TITAN ENGINE" FontSize="26" FontWeight="Black" Foreground="White"/>
                        <TextBlock FontSize="11" Foreground="#00CCFF" Opacity="0.8" FontWeight="Bold"><Run Text="V192"/></TextBlock>
                        <TextBlock FontSize="10" Foreground="#888" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="520" Text="Changelog: + Hiệu ứng chữ Text Overlay (từ Caption Sync) | + Hiệu ứng Audio 1 Voice FX | + Thanh cường độ Audio FX | + Lọc file build GitHub | + Không xóa tính năng cũ"/>
                    </StackPanel>
                </StackPanel>

                <!-- SCROLLABLE CONTENT -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,10">
                    <StackPanel>
                        <!-- 1. SOURCE FILES -->
                        <GroupBox Header="SOURCE &amp; TRIM" Foreground="#00CCFF" FontSize="13">
                            <StackPanel>
                                <TextBlock Text="Source Media (Video/Image)" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtVideoPath" Grid.Column="0" IsReadOnly="True" Text="Drop Video/Image Here..." FontStyle="Italic" Opacity="0.5"/>
                                    <Button x:Name="btnBrowseVideo" Content="..." Grid.Column="1" Margin="8,0,0,0" Click="BtnBrowseVideo_Click"/>
                                </Grid>

                                <CheckBox x:Name="chkMergeVideos" Content="Merge Videos Into One Output (Concat)" Foreground="#66E0FF" Margin="0,-5,0,5" Checked="MergeOptionChanged" Unchecked="MergeOptionChanged"/>

                                <StackPanel Margin="0,0,0,10">
                                    <CheckBox x:Name="chkEnableCrossTransitions" Content="⚡ CapCut Cross-Clip Transitions" Foreground="#FF66C4" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <Grid Margin="15,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbCrossTransitionType" Grid.Column="0" Height="28" Padding="6,4,6,4" FontSize="11" Background="#181825" Foreground="White" SelectedIndex="0">
                                            <ComboBoxItem Content="Dissolve"/>
                                            <ComboBoxItem Content="Fade (Black)"/>
                                            <ComboBoxItem Content="Fade (White)"/>
                                            <ComboBoxItem Content="Fade (Blur)"/>
                                            <ComboBoxItem Content="Fade (Opacity)"/>
                                            <ComboBoxItem Content="Whip Left"/>
                                            <ComboBoxItem Content="Whip Right"/>
                                            <ComboBoxItem Content="Whip Up"/>
                                            <ComboBoxItem Content="Whip Down"/>
                                            <ComboBoxItem Content="Zoom"/>
                                            <ComboBoxItem Content="Circle Crop"/>
                                            <ComboBoxItem Content="Radial Clock"/>
                                            <ComboBoxItem Content="Pixelize"/>
                                            <ComboBoxItem Content="Light Leak Burn"/>
                                            <ComboBoxItem Content="HBlur"/>
                                        </ComboBox>
                                        <TextBox x:Name="txtCrossTransitionDuration" Grid.Column="2" Text="0.6" Height="28" Padding="4,2,4,2" FontSize="12" FontWeight="Bold" Background="#181825" Foreground="#00FFCC" BorderBrush="#313244" BorderThickness="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="Transition Duration in seconds (e.g. 0.6)"/>
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start (00:00:00)" Foreground="#FFCC00" FontSize="11"/>
                                        <TextBox x:Name="txtTrimStart" Text="00:00:00"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Duration" Foreground="#FFCC00" FontSize="11"/>
                                        <TextBox x:Name="txtTrimDuration" ToolTip="Empty = Full"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Split Duration (sec)" Foreground="#FFCC00" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="txtSplitDuration" ToolTip="Split rendered video into segments of this duration (seconds). Leave empty to skip splitting."/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Image Timeline Duration (sec)" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="txtImageTimelineDuration" ToolTip="Total duration shared across all selected image inputs. Leave empty to keep default per-image timing."/>
                                </StackPanel>

                                <TextBlock Text="Audio 1 (Opt)" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtAudioPath" Grid.Column="0" IsReadOnly="True" Text="Select Audio 1..." FontStyle="Italic" Opacity="0.5"/>
                                    <Button x:Name="btnBrowseAudio" Content="..." Grid.Column="1" Margin="8,0,0,0" Click="BtnBrowseAudio_Click"/>
                                </Grid>
                                <TextBlock Text="Audio 2 (Overlay)" Foreground="#888" FontSize="11" Margin="0,10,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtAudioPath2" Grid.Column="0" IsReadOnly="True" Text="Select Audio 2..." FontStyle="Italic" Opacity="0.5"/>
                                    <Button x:Name="btnBrowseAudio2" Content="..." Grid.Column="1" Margin="8,0,0,0" Click="BtnBrowseAudio2_Click"/>
                                </Grid>
                                <CheckBox x:Name="chkMergeAudios" Content="Merge Audio Tracks Into One Output (Concat)" Foreground="#FFD580" Margin="0,8,0,0" Checked="MergeOptionChanged" Unchecked="MergeOptionChanged"/>
                                <Button x:Name="btnRandomCombos" Content="🎲 RANDOM VIDEO × AUDIO" Visibility="Collapsed" Background="#6A4C00" BorderBrush="#FFCC00" Foreground="#FFE680" FontWeight="Bold" Margin="0,8,0,0" Height="44" Click="BtnRandomCombos_Click" ToolTip="Tạo mọi tổ hợp Video/Image × Audio thành nhiều queue, giữ nguyên toàn bộ setting hiện tại"/>
                                <Button x:Name="btnEditAudio" Content="EDIT AUDIO DURATIONS" Background="#4A3D7A" BorderBrush="#9B84EC" Margin="0,10,0,0" Click="BtnOpenAudioEditor_Click"/>
                                <TextBlock x:Name="txtAudioEditSummary" Text="No audio cuts applied" Foreground="#777" FontSize="9" Margin="0,4,0,0"/>

                                <Grid Margin="0,12,0,5">
                                    <TextBlock Text="Added Audio Speed" Foreground="#DDD" FontSize="11"/>
                                    <TextBlock Text="{Binding ElementName=sldExternalAudioSpeed, Path=Value, StringFormat={}{0:0.00}x}" Foreground="#FFD580" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="sldExternalAudioSpeed" Minimum="0.25" Maximum="4.0" Value="1.0" TickFrequency="0.25" AutoToolTipPlacement="TopLeft"/>
                                <TextBlock Text="Only the optional audio track is affected" Foreground="#666" FontSize="9" Margin="0,3,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- BUTTON ADD TO QUEUE -->
                        <Button x:Name="btnAddJob" Height="50" Click="BtnAddJob_Click" Background="#0066CC" BorderBrush="#0088FF" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="20" FontWeight="Bold" Margin="0,0,10,0"/>
                                <TextBlock Text="ADD TO QUEUE" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <!-- 2. FX STUDIO (ĐÃ THÊM LẠI VISUAL BAR) -->
                        <GroupBox Header="FX STUDIO" Foreground="#9B84EC" FontSize="13">
                            <StackPanel>
                                <TextBlock Text="Effect" Foreground="#888" FontSize="11"/>
                                <ComboBox x:Name="cmbFxType" Margin="0,0,0,10" SelectionChanged="FxOrOverlaySelectionChanged">
                                    <ComboBoxItem Content="None" IsSelected="True"/>
                                    <ComboBoxItem Content="Flip Horizontal (Anti-Copyright)"/>
                                    <ComboBoxItem Content="Rò phim (Leak 1 / Light Leak)"/>
                                    <ComboBoxItem Content="Light Leak Burn"/>
                                    <ComboBoxItem Content="Cinematic Glow"/>
                                    <ComboBoxItem Content="Halo Glow"/>
                                    <ComboBoxItem Content="Prism Light"/>
                                    <ComboBoxItem Content="Editorial Bloom"/>
                                    <ComboBoxItem Content="Crop Video (Custom Frame)"/>
                                </ComboBox>

                                <TextBlock Text="Template (CapCut Style)" Foreground="#888" FontSize="11"/>
                                <ComboBox x:Name="cmbTemplateStyle" Margin="0,0,0,10">
                                    <ComboBoxItem Content="None" IsSelected="True"/>
                                    <ComboBoxItem Content="Smooth Zoom In"/>
                                    <ComboBoxItem Content="Smooth Zoom Out"/>
                                    <ComboBoxItem Content="Pan Left"/>
                                    <ComboBoxItem Content="Pan Right"/>
                                    <ComboBoxItem Content="Velocity Punch"/>
                                    <ComboBoxItem Content="Cinematic Fade Zoom"/>
                                    <ComboBoxItem Content="Glitch Distort"/>
                                    <ComboBoxItem Content="3D Spin Lite"/>
                                    <ComboBoxItem Content="Trend Zoom Flash"/>
                                    <ComboBoxItem Content="Trend Blur Pulse"/>
                                    <ComboBoxItem Content="Trend Spin Glitch"/>
                                    <ComboBoxItem Content="Digicam Memory"/>
                                    <ComboBoxItem Content="Beat Photo Dump"/>
                                    <ComboBoxItem Content="Film Strip"/>
                                    <ComboBoxItem Content="Magazine Cover"/>
                                </ComboBox>

                                <TextBlock Text="Overlay" Foreground="#888" FontSize="11"/>
                                <StackPanel Margin="0,0,0,12">
                                    <CheckBox x:Name="chkSnowOverlay1"
                                              Content="Overlay 1"
                                              Foreground="#AEEBFF"
                                              Margin="0,0,0,6"
                                              Checked="FxOrOverlayToggleChanged"
                                              Unchecked="FxOrOverlayToggleChanged"/>
                                    <CheckBox x:Name="chkSnowOverlay2"
                                              Content="Overlay 2"
                                              Foreground="#AEEBFF"
                                              Margin="0,0,0,6"
                                              Checked="FxOrOverlayToggleChanged"
                                              Unchecked="FxOrOverlayToggleChanged"/>
                                    <CheckBox x:Name="chkSnowOverlay3"
                                              Content="Overlay 3"
                                              Foreground="#AEEBFF"
                                              Margin="0,0,0,6"
                                              Checked="FxOrOverlayToggleChanged"
                                              Unchecked="FxOrOverlayToggleChanged"/>
                                    <CheckBox x:Name="chkOverlayIntro"
                                              Content="Overlay Intro"
                                              Foreground="#AEEBFF"
                                              Checked="FxOrOverlayToggleChanged"
                                              Unchecked="FxOrOverlayToggleChanged"/>
                                </StackPanel>

                                <StackPanel x:Name="pnlRainOverlaySettings" Visibility="Collapsed" Margin="0,-4,0,12">
                                    <TextBlock Text="Rain Preset" Foreground="#888" FontSize="11"/>
                                    <ComboBox x:Name="cmbRainOverlayPreset" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Heavy Rain" IsSelected="True"/>
                                        <ComboBoxItem Content="Cinematic Rain"/>
                                        <ComboBoxItem Content="Window Drops"/>
                                    </ComboBox>

                                    <TextBlock Text="Rain Intensity" Foreground="#888" FontSize="11"/>
                                    <ComboBox x:Name="cmbRainOverlayIntensity" Margin="0,0,0,4">
                                        <ComboBoxItem Content="medium" IsSelected="True"/>
                                        <ComboBoxItem Content="subtle"/>
                                        <ComboBoxItem Content="strong"/>
                                    </ComboBox>
                                    <TextBlock Text="Uses real rain video assets from Assets/Overlays/Rain"
                                               Foreground="#666"
                                               FontSize="9"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Text="Border" Foreground="#888" FontSize="11"/>
                                <ComboBox x:Name="cmbBorderType" Margin="0,0,0,12" SelectionChanged="FxOrOverlaySelectionChanged">
                                    <ComboBoxItem Content="None" IsSelected="True"/>
                                    <ComboBoxItem Content="Polaroid Scrapbook"/>
                                    <ComboBoxItem Content="Polaroid Scrapbook 2"/>
                                    <ComboBoxItem Content="RGB Polaroid Border"/>
                                    <ComboBoxItem Content="Dashed Polaroid Frame"/>
                                </ComboBox>

                                <StackPanel x:Name="pnlSnowfallOpacity" Visibility="Collapsed" Margin="0,-4,0,12">
                                    <StackPanel x:Name="pnlSnowOverlay1Opacity" Visibility="Collapsed" Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Overlay 1 Opacity" Foreground="#888" FontSize="11"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=sldSnowOverlay1Opacity, Path=Value, StringFormat={}{0:0}%}"
                                                       Foreground="#B8F2FF"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Grid>
                                        <Slider x:Name="sldSnowOverlay1Opacity"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="55"
                                                TickFrequency="1"
                                                AutoToolTipPlacement="TopLeft"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlSnowOverlay2Opacity" Visibility="Collapsed" Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Overlay 2 Opacity" Foreground="#888" FontSize="11"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=sldSnowOverlay2Opacity, Path=Value, StringFormat={}{0:0}%}"
                                                       Foreground="#B8F2FF"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Grid>
                                        <Slider x:Name="sldSnowOverlay2Opacity"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="55"
                                                TickFrequency="1"
                                                AutoToolTipPlacement="TopLeft"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlSnowOverlay3Opacity" Visibility="Collapsed" Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Overlay 3 Opacity" Foreground="#888" FontSize="11"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=sldSnowOverlay3Opacity, Path=Value, StringFormat={}{0:0}%}"
                                                       Foreground="#B8F2FF"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Grid>
                                        <Slider x:Name="sldSnowOverlay3Opacity"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="55"
                                                TickFrequency="1"
                                                AutoToolTipPlacement="TopLeft"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlOverlayIntroOpacity" Visibility="Collapsed" Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Intro Opacity" Foreground="#888" FontSize="11"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=sldOverlayIntroOpacity, Path=Value, StringFormat={}{0:0}%}"
                                                       Foreground="#B8F2FF"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Grid>
                                        <Slider x:Name="sldOverlayIntroOpacity"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="100"
                                                TickFrequency="1"
                                                AutoToolTipPlacement="TopLeft"/>
                                    </StackPanel>

                                    <StackPanel x:Name="pnlSnowSharedOpacity" Visibility="Collapsed" Margin="0,0,0,8">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Snow Opacity" Foreground="#888" FontSize="11"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=sldSnowfallOpacity, Path=Value, StringFormat={}{0:0}%}"
                                                       Foreground="#B8F2FF"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Grid>
                                        <Slider x:Name="sldSnowfallOpacity"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="55"
                                                TickFrequency="1"
                                                AutoToolTipPlacement="TopLeft"/>
                                    </StackPanel>

                                    <TextBlock Text="Overlay 1, 2, 3, and Intro use separate opacity sliders."
                                               Foreground="#666"
                                               FontSize="9"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <CheckBox x:Name="chkEnableBrandLogo"
                                          Content="Use TITAN Logo"
                                          Foreground="#AEEBFF"
                                          Margin="0,-4,0,8"/>

                                <TextBlock Text="Logo Position" Foreground="#888" FontSize="11"/>
                                <ComboBox x:Name="cmbBrandLogoPosition" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Top Right" IsSelected="True"/>
                                    <ComboBoxItem Content="Top Left"/>
                                    <ComboBoxItem Content="Center Top"/>
                                    <ComboBoxItem Content="Bottom Right"/>
                                    <ComboBoxItem Content="Bottom Left"/>
                                    <ComboBoxItem Content="Center Bottom"/>
                                </ComboBox>

                                <TextBlock Text="Intensity" Foreground="#888" FontSize="11"/>
                                <Slider x:Name="sldFxIntensity" Minimum="0" Maximum="100" Value="50" Margin="0,0,0,15"/>

                                <TextBlock Text="Magazine Cover Title" Foreground="#888" FontSize="11"/>
                                <TextBox x:Name="txtMagazineCoverTitle" Text="TITAN" Margin="0,0,0,8"/>

                                <TextBlock Text="Magazine Cover Subtitle" Foreground="#888" FontSize="11"/>
                                <TextBox x:Name="txtMagazineCoverSubtitle" Text="COVER STORY" Margin="0,0,0,12"/>

                                <TextBlock Text="Crop Zoom (9:16)" Foreground="#888" FontSize="11"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Center crop and zoom in automatically" Foreground="#666" FontSize="10"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ElementName=sldCropZoom, Path=Value, StringFormat={}{0:0}%}"
                                               Foreground="#FFCC66"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="sldCropZoom"
                                        Minimum="0"
                                        Maximum="80"
                                        Value="0"
                                        TickFrequency="1"
                                        AutoToolTipPlacement="TopLeft"
                                        Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbCropAspectRatio" Visibility="Collapsed">
                                    <ComboBoxItem Content="Free" IsSelected="True"/>
                                </ComboBox>
                                <TextBlock Text="0% = no crop, 50% = medium zoom crop. Output is kept in 9:16."
                                           Foreground="#666"
                                           FontSize="10"
                                           Margin="0,0,0,12"
                                           TextWrapping="Wrap"/>

                                <!-- [FIX] VISUAL TIMELINE BAR (THÀNH PHẦN BỊ THIẾU) -->
                                <TextBlock Text="Timeline Preview (Phạm vi áp dụng)" Foreground="#FFCC00" FontSize="11" Margin="0,0,0,5"/>
                                <Border x:Name="brdTimelineContainer" BorderBrush="#444" BorderThickness="1" Height="25" Background="#1A1A1A" Margin="0,0,0,10" CornerRadius="3">
