                                    <ComboBoxItem Content="Phaser (Âm kim loại)"/>
                                    <ComboBoxItem Content="Bitcrush (Giọng rè kỹ thuật số)"/>
                                    <ComboBoxItem Content="Whisper (Thì thầm)"/>
                                </ComboBox>
                                <TextBlock Text="Áp dụng cho Audio 1 (giọng nói gốc). Các track Audio 2 giữ nguyên." Foreground="#8B95A5" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap"/>

                                <Grid Margin="0,0,0,5">
                                    <TextBlock Text="Cường độ hiệu ứng Audio 1" Foreground="#C9D2DE" FontSize="11"/>
                                    <TextBlock Text="{Binding ElementName=sldAudio1FxIntensity, Path=Value, StringFormat={}{0:0}%}" Foreground="#4CC3FF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="sldAudio1FxIntensity" Minimum="0" Maximum="100" Value="100" TickFrequency="10" AutoToolTipPlacement="TopLeft" Margin="0,0,0,8"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 5. WATERMARK -->
                        <GroupBox Header="WATERMARK ( DEBUGGING ) " Foreground="#F43F5E" FontSize="13">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtWatermarkPath" IsReadOnly="True" Text="Select Logo..." FontStyle="Italic" Opacity="0.5"/>
                                    <Button x:Name="btnBrowseWatermark" Content="..." Grid.Column="1" Margin="8,0,0,0" Click="BtnBrowseWatermark_Click"/>
                                </Grid>
                                <Button Content="EDIT POSITION (VISUAL)" Background="#F43F5E" BorderBrush="#F871A0" Click="BtnOpenWatermarkEditor_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 6. COLOR GRADING -->
                        <GroupBox Header="COLOR GRADING" Foreground="#4CC3FF" FontSize="13">
                            <StackPanel>
                                <ComboBox x:Name="cmbColorFilter">
                                    <ComboBoxItem Content="None (Original)" IsSelected="True"/>
                                    <ComboBoxItem Content="Spring"/>
                                    <ComboBoxItem Content="Autumn"/>
                                    <ComboBoxItem Content="Winter"/>
                                    <ComboBoxItem Content="Cold"/>
                                    <ComboBoxItem Content="Warm"/>
                                    <ComboBoxItem Content="Cinematic"/>
                                </ComboBox>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock Text="Intensity" Foreground="#C9D2DE" FontSize="11"/>
                                    <TextBlock Text="{Binding ElementName=sldColorIntensity, Path=Value, StringFormat={}{0:0}%}" Foreground="#4CC3FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="sldColorIntensity" Minimum="0" Maximum="100" Value="50"/>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="Brightness" Foreground="#C9D2DE" FontSize="11"/>
                                    <TextBlock Text="{Binding ElementName=sldVideoBrightness, Path=Value, StringFormat={}{0:+0;-0;0}}" Foreground="#4CC3FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="sldVideoBrightness" Minimum="-100" Maximum="100" Value="0" TickFrequency="10" AutoToolTipPlacement="TopLeft"/>
                                <TextBlock Text="-100 dark | 0 original | +100 bright" Foreground="#5C6672" FontSize="9" Margin="0,3,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 7. EXPORT -->
                        <GroupBox Header="EXPORT" Foreground="#4CC3FF" FontSize="13">
                            <StackPanel>
                                <TextBox x:Name="txtOutputDir" IsReadOnly="True" Text="Default: Desktop"/>
                                <Button x:Name="btnBrowseOutput" Content="Browse Folder..." Margin="0,5,0,10" Click="BtnBrowseOutput_Click"/>
                                <TextBox x:Name="txtOutputName" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Resolution" Foreground="#8B95A5" FontSize="11"/>
                                        <ComboBox x:Name="cmbRes" SelectionChanged="CmbRes_SelectionChanged">
                                            <ComboBoxItem Content="Original"/>
                                            <ComboBoxItem Content="1920x1080 (HD)"/>
                                            <ComboBoxItem Content="1080x1920 (Portrait)" IsSelected="True"/>
                                            <ComboBoxItem Content="720x1280 (Portrait HD)"/>
                                            <ComboBoxItem Content="1280x720"/>
                                            <ComboBoxItem Content="Custom (Nhập số)"/>
                                        </ComboBox>
                                        <Grid x:Name="gridCustomRes" Visibility="Collapsed" Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtResW" Grid.Column="0" Text="1080" ToolTip="Width" TextChanged="TxtOutputResolution_TextChanged"/>
                                            <TextBlock Text="x" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8B95A5"/>
                                            <TextBox x:Name="txtResH" Grid.Column="2" Text="1920" ToolTip="Height" TextChanged="TxtOutputResolution_TextChanged"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="FPS" Foreground="#8B95A5" FontSize="11"/>
                                        <ComboBox x:Name="cmbFps">
                                            <ComboBoxItem Content="Original" IsSelected="True"/>
                                            <ComboBoxItem Content="60"/>
                                            <ComboBoxItem Content="30"/>
                                            <ComboBoxItem Content="24"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <ComboBox x:Name="cmbHardware" Margin="0,0,0,10">
                                    <ComboBoxItem Content="NVIDIA NVENC" IsSelected="True"/>
                                    <ComboBoxItem Content="NVIDIA NVENC (AV1)"/>
                                    <ComboBoxItem Content="AMD AMF"/>
                                    <ComboBoxItem Content="AMD AMF (AV1)"/>
                                    <ComboBoxItem Content="Cpu"/>
                                </ComboBox>
                                <ComboBox x:Name="cmbBitrate" SelectionChanged="CmbBitrate_SelectionChanged">
                                    <ComboBoxItem Content="Match Source" IsSelected="True"/>
                                    <ComboBoxItem Content="Boost Quality"/>
                                    <ComboBoxItem Content="Custom (Kbps)"/>
                                </ComboBox>
                                <TextBox x:Name="txtCustomBitrate" Margin="0,5,0,0" Visibility="Collapsed" Text="5000"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- RIGHT PANEL -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#11141A" CornerRadius="10" BorderBrush="#1E242E" BorderThickness="1">
                    <Grid>
                    <ListBox x:Name="lstQueue" Background="Transparent" BorderThickness="0" Padding="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#151A21" Margin="0,0,0,8" CornerRadius="8" Padding="11">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#232B36"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApiJob}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4CC3FF"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#12161D" BorderBrush="#232B36" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Id}" FontWeight="Bold" Foreground="#8B95A5" FontSize="11"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#F0F4F8" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ConfigSummary}" FontSize="10" Foreground="#9AA3B2" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Border Background="#103040" BorderBrush="#4CC3FF" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="0,0,10,4" HorizontalAlignment="Right" Visibility="Collapsed">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApiJob}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="API" Foreground="#4CC3FF" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <Border Background="#12161D" BorderBrush="#232B36" BorderThickness="1" CornerRadius="9" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                            <Button Content="\u2715" Width="25" Height="25" Background="#2A1218" FontSize="10" ToolTip="Remove this job" Click="BtnDeleteJob_Click" Tag="{Binding Id}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No jobs yet - drop files or add from the left panel"
                               Foreground="#5C6672" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=lstQueue}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </Border>

                <ProgressBar x:Name="pbGlobalProgress" Grid.Row="1" Margin="0,5" Minimum="0" Maximum="100" Value="0" Background="#0D1014" BorderThickness="0" Height="10">
                    <ProgressBar.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#6FD4FF" Offset="0"/>
                            <GradientStop Color="#4CC3FF" Offset="1"/>
                        </LinearGradientBrush>
                    </ProgressBar.Foreground>
                </ProgressBar>

                <Border Grid.Row="2" Background="#0D1014" CornerRadius="10" BorderBrush="#1E242E" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="#1E242E" BorderThickness="0,0,0,1" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#4CC3FF" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="SYSTEM LOG" FontSize="10" FontWeight="SemiBold" Foreground="#8B95A5"/>
                            </StackPanel>
                        </Border>
                    <TextBox Grid.Row="1" x:Name="txtLogs" Background="Transparent" Foreground="#7EE787" FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="10" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnClear" Content="CLEAR" Grid.Column="0" Margin="0,0,15,0" Background="#1A202A" Click="BtnClear_Click"/>
                    <Button x:Name="btnStart" Grid.Column="1" Margin="0,0,15,0" Click="BtnStartBatch_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#22C55E" Offset="0"/>
                                <GradientStop Color="#149E44" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock Text="START BATCH" FontWeight="Bold" FontSize="14"/>
                    </Button>
                    <Button x:Name="btnHostMode" Grid.Column="2" Content="HOST: OFF" Click="BtnHostMode_Click" Background="#2A1518" BorderBrush="#5A2A32"/>
                </Grid>
            </Grid>
        </Grid>
        <!-- CROP OVERLAY -->
        <Grid x:Name="gridCropOverlay" Visibility="Collapsed" Background="#E5060A10">
            <Border Background="#12151C" Width="920" Height="640" CornerRadius="10" BorderBrush="#8B7CF6" BorderThickness="2">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CROP VIDEO EDITOR" FontSize="18" FontWeight="Bold" Foreground="#8B7CF6" HorizontalAlignment="Center"/>
                    <Border Grid.Row="1" BorderBrush="#2A3340" BorderThickness="1" Background="Black" Margin="0,10" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="cvsCropPreview" Width="1920" Height="1080" Background="Black">
                                <MediaElement x:Name="medCropPreview"
                                              Width="1920"
                                              Height="1080"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              Stretch="Fill"
                                              MediaOpened="MedCropPreview_MediaOpened"
                                              MediaFailed="MedCropPreview_MediaFailed"
                                              Canvas.Left="0"
                                              Canvas.Top="0"/>
                                <Image x:Name="imgCropPreviewFrame"
                                       Width="1920"
                                       Height="1080"
                                       Stretch="Fill"
                                       Canvas.Left="0"
                                       Canvas.Top="0"/>
                                <Border x:Name="bdrCropFrame"
                                        Width="1280"
                                        Height="720"
                                        Canvas.Left="320"
                                        Canvas.Top="180"
                                        BorderBrush="#4CC3FF"
                                        BorderThickness="2"
                                        Background="#224CC3FF"
                                        Cursor="SizeAll"
                                        MouseLeftButtonDown="BdrCropFrame_MouseDown"
                                        MouseMove="BdrCropFrame_MouseMove"
                                        MouseLeftButtonUp="BdrCropFrame_MouseUp">
                                    <Grid>
                                        <Border Margin="8" BorderBrush="#66FFFFFF" BorderThickness="1"/>
                                        <TextBlock Text="CROP AREA" Foreground="#CCFFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                        <Thumb Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,-8,0,0" Cursor="SizeNWSE" Background="#4CC3FF" BorderBrush="#FFFFFF" BorderThickness="1" Tag="TL" DragDelta="CropHandle_DragDelta"/>
                                        <Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Cursor="SizeNESW" Background="#4CC3FF" BorderBrush="#FFFFFF" BorderThickness="1" Tag="TR" DragDelta="CropHandle_DragDelta"/>
                                        <Thumb Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-8,0,0,-8" Cursor="SizeNESW" Background="#4CC3FF" BorderBrush="#FFFFFF" BorderThickness="1" Tag="BL" DragDelta="CropHandle_DragDelta"/>
                                        <Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-8" Cursor="SizeNWSE" Background="#4CC3FF" BorderBrush="#FFFFFF" BorderThickness="1" Tag="BR" DragDelta="CropHandle_DragDelta"/>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,2,0,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Video Timeline" Foreground="#9AA3B2" FontSize="11"/>
                            <TextBlock x:Name="txtCropTimelineTime" Foreground="#8B7CF6" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="sldCropTimeline"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                TickFrequency="1"
                                IsSnapToTickEnabled="False"
                                ValueChanged="SldCropTimeline_ValueChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="txtCropInfo" Grid.Row="3" Foreground="#9AA3B2" FontSize="11" TextAlignment="Center" Margin="0,6,0,0"/>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="CANCEL" Width="100" Height="35" Background="#232B36" Margin="0,0,10,0" Click="BtnCancelCrop_Click"/>
                        <Button Content="SAVE CROP" Width="150" Height="35" Background="#241E38" BorderBrush="#8B7CF6" FontWeight="Bold" Click="BtnSaveCrop_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- WATERMARK OVERLAY -->
        <Grid x:Name="gridWatermarkOverlay" Visibility="Collapsed" Background="#E5060A10">
            <Border Background="#12151C" Width="900" Height="600" CornerRadius="10" BorderBrush="#F43F5E" BorderThickness="2">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="VISUAL EDITOR" FontSize="18" FontWeight="Bold" Foreground="#F43F5E" HorizontalAlignment="Center"/>
                    <Border Grid.Row="1" BorderBrush="#2A3340" BorderThickness="1" Background="Black" Margin="0,10" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Grid>
                                <Grid x:Name="gridPreviewContainer" Width="1920" Height="1080" Background="Black">
                                    <Image x:Name="imgWatermarkVideoFrame" Width="1920" Height="1080" Stretch="Fill"/>
                                </Grid>
                                <Canvas x:Name="cvsWatermarkPreview" Width="1920" Height="1080" Background="Transparent">
                                    <Image x:Name="imgWatermarkPreview" Width="150" Height="150" RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="ImgWatermark_MouseDown" MouseLeftButtonUp="ImgWatermark_MouseUp" MouseMove="ImgWatermark_MouseMove" Cursor="SizeAll">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="stWatermark"/>
                                                <RotateTransform x:Name="rtWatermark"/>
                                                <TranslateTransform x:Name="ttWatermark"/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Scale" Foreground="White"/>
                        <Slider x:Name="sldWmkScale" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="SldWmk_ValueChanged"/>
                        <TextBlock Text="Rotation" Foreground="White"/>
                        <Slider x:Name="sldWmkRotate" Minimum="-180" Maximum="180" Value="0" ValueChanged="SldWmk_ValueChanged"/>
                        <TextBlock Text="Opacity" Foreground="White"/>
                        <Slider x:Name="sldWmkOpacity" Minimum="0.1" Maximum="1.0" Value="1.0" ValueChanged="SldWmk_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="CANCEL" Width="100" Height="35" Background="#232B36" Margin="0,0,10,0" Click="BtnCancelWatermark_Click"/>
                        <Button Content="SAVE" Width="150" Height="35" Background="#F43F5E" FontWeight="Bold" Click="BtnSaveWatermark_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
