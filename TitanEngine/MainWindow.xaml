                                </ComboBox>
                                <Grid Margin="0,5,0,0">
                                    <TextBlock Text="Intensity" Foreground="#DDD" FontSize="11"/>
                                    <TextBlock Text="{Binding ElementName=sldColorIntensity, Path=Value, StringFormat={}{0:0}%}" Foreground="#AA00FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="sldColorIntensity" Minimum="0" Maximum="100" Value="50"/>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="Brightness" Foreground="#DDD" FontSize="11"/>
                                    <TextBlock Text="{Binding ElementName=sldVideoBrightness, Path=Value, StringFormat={}{0:+0;-0;0}}" Foreground="#AA00FF" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="sldVideoBrightness" Minimum="-100" Maximum="100" Value="0" TickFrequency="10" AutoToolTipPlacement="TopLeft"/>
                                <TextBlock Text="-100 dark | 0 original | +100 bright" Foreground="#666" FontSize="9" Margin="0,3,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 7. EXPORT -->
                        <GroupBox Header="EXPORT" Foreground="#00FF99" FontSize="13">
                            <StackPanel>
                                <TextBox x:Name="txtOutputDir" IsReadOnly="True" Text="Default: Desktop"/>
                                <Button x:Name="btnBrowseOutput" Content="Browse Folder..." Margin="0,5,0,10" Click="BtnBrowseOutput_Click"/>
                                <TextBox x:Name="txtOutputName" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Resolution" Foreground="#888" FontSize="11"/>
                                        <ComboBox x:Name="cmbRes" SelectionChanged="CmbRes_SelectionChanged">
                                            <ComboBoxItem Content="Original"/>
                                            <ComboBoxItem Content="1920x1080 (HD)"/>
                                            <ComboBoxItem Content="1080x1920 (Portrait)" IsSelected="True"/>
                                            <ComboBoxItem Content="720x1280 (Portrait HD)"/>
                                            <ComboBoxItem Content="1280x720"/>
                                            <ComboBoxItem Content="Custom (Nhập số)"/>
                                        </ComboBox>
                                        <Grid x:Name="gridCustomRes" Visibility="Collapsed" Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtResW" Grid.Column="0" Text="1080" ToolTip="Width"/>
                                            <TextBlock Text="x" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888"/>
                                            <TextBox x:Name="txtResH" Grid.Column="2" Text="1920" ToolTip="Height"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="FPS" Foreground="#888" FontSize="11"/>
                                        <ComboBox x:Name="cmbFps">
                                            <ComboBoxItem Content="Original" IsSelected="True"/>
                                            <ComboBoxItem Content="60"/>
                                            <ComboBoxItem Content="30"/>
                                            <ComboBoxItem Content="24"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <ComboBox x:Name="cmbHardware" Margin="0,0,0,10">
                                    <ComboBoxItem Content="NVIDIA NVENC" IsSelected="True"/>
                                    <ComboBoxItem Content="NVIDIA NVENC (AV1)"/>
                                    <ComboBoxItem Content="AMD AMF"/>
                                    <ComboBoxItem Content="AMD AMF (AV1)"/>
                                    <ComboBoxItem Content="Cpu"/>
                                </ComboBox>
                                <ComboBox x:Name="cmbBitrate" SelectionChanged="CmbBitrate_SelectionChanged">
                                    <ComboBoxItem Content="Match Source" IsSelected="True"/>
                                    <ComboBoxItem Content="Boost Quality"/>
                                    <ComboBoxItem Content="Custom (Kbps)"/>
                                </ComboBox>
                                <TextBox x:Name="txtCustomBitrate" Margin="0,5,0,0" Visibility="Collapsed" Text="5000"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- RIGHT PANEL -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#181818" CornerRadius="6" BorderBrush="#333" BorderThickness="1">
                    <ListBox x:Name="lstQueue" Background="Transparent" BorderThickness="0" Padding="10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252528" Margin="0,0,0,8" CornerRadius="6" Padding="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#333"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsApiJob}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#00CCFF"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#E0E0E0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ConfigSummary}" FontSize="10" Foreground="#AAA" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Border Background="#103040" BorderBrush="#00CCFF" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="0,0,10,4" HorizontalAlignment="Right" Visibility="Collapsed">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsApiJob}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="API" Foreground="#00CCFF" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <Button Content="?" Width="25" Height="25" Background="#331111" Click="BtnDeleteJob_Click" Tag="{Binding Id}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <ProgressBar x:Name="pbGlobalProgress" Grid.Row="1" Margin="0,5" Minimum="0" Maximum="100" Value="0" Background="#181818" Foreground="#00CCFF" BorderThickness="0" Height="10"/>

                <Border Grid.Row="2" Background="#0F0F0F" CornerRadius="6" BorderBrush="#333" BorderThickness="1">
                    <TextBox x:Name="txtLogs" Background="Transparent" Foreground="#00FF00" FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="10" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnClear" Content="CLEAR" Grid.Column="0" Margin="0,0,15,0" Background="#252525" Click="BtnClear_Click"/>
                    <Button x:Name="btnStart" Grid.Column="1" Margin="0,0,15,0" Click="BtnStartBatch_Click" Background="#00AA55">
                        <TextBlock Text="START BATCH" FontWeight="Bold" FontSize="14"/>
                    </Button>
                    <Button x:Name="btnHostMode" Grid.Column="2" Content="HOST: OFF" Click="BtnHostMode_Click" Background="#553333" BorderBrush="#884444"/>
                </Grid>
            </Grid>
        </Grid>
        <!-- CROP OVERLAY -->
        <Grid x:Name="gridCropOverlay" Visibility="Collapsed" Background="#CC000000">
            <Border Background="#1A1A1E" Width="920" Height="640" CornerRadius="10" BorderBrush="#9B84EC" BorderThickness="2">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CROP VIDEO EDITOR" FontSize="18" FontWeight="Bold" Foreground="#9B84EC" HorizontalAlignment="Center"/>
                    <Border Grid.Row="1" BorderBrush="#444" BorderThickness="1" Background="Black" Margin="0,10" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="cvsCropPreview" Width="1920" Height="1080" Background="Black">
                                <MediaElement x:Name="medCropPreview"
                                              Width="1920"
                                              Height="1080"
                                              LoadedBehavior="Manual"
                                              UnloadedBehavior="Manual"
                                              Stretch="Fill"
                                              MediaOpened="MedCropPreview_MediaOpened"
                                              MediaFailed="MedCropPreview_MediaFailed"
                                              Canvas.Left="0"
                                              Canvas.Top="0"/>
                                <Image x:Name="imgCropPreviewFrame"
                                       Width="1920"
                                       Height="1080"
                                       Stretch="Fill"
                                       Canvas.Left="0"
                                       Canvas.Top="0"/>
                                <Border x:Name="bdrCropFrame"
                                        Width="1280"
                                        Height="720"
                                        Canvas.Left="320"
                                        Canvas.Top="180"
                                        BorderBrush="#00CCFF"
                                        BorderThickness="2"
                                        Background="#2200CCFF"
                                        Cursor="SizeAll"
                                        MouseLeftButtonDown="BdrCropFrame_MouseDown"
                                        MouseMove="BdrCropFrame_MouseMove"
                                        MouseLeftButtonUp="BdrCropFrame_MouseUp">
                                    <Grid>
                                        <Border Margin="8" BorderBrush="#66FFFFFF" BorderThickness="1"/>
                                        <TextBlock Text="CROP AREA" Foreground="#CCFFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                        <Thumb Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-8,-8,0,0" Cursor="SizeNWSE" Background="#00CCFF" BorderBrush="#FFFFFF" BorderThickness="1" Tag="TL" DragDelta="CropHandle_DragDelta"/>
                                        <Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0" Cursor="SizeNESW" Background="#00CCFF" BorderBrush="#FFFFFF" BorderThickness="1" Tag="TR" DragDelta="CropHandle_DragDelta"/>
                                        <Thumb Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-8,0,0,-8" Cursor="SizeNESW" Background="#00CCFF" BorderBrush="#FFFFFF" BorderThickness="1" Tag="BL" DragDelta="CropHandle_DragDelta"/>
                                        <Thumb Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-8" Cursor="SizeNWSE" Background="#00CCFF" BorderBrush="#FFFFFF" BorderThickness="1" Tag="BR" DragDelta="CropHandle_DragDelta"/>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,2,0,0">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Video Timeline" Foreground="#AAAAAA" FontSize="11"/>
                            <TextBlock x:Name="txtCropTimelineTime" Foreground="#9B84EC" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="sldCropTimeline"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                TickFrequency="1"
                                IsSnapToTickEnabled="False"
                                ValueChanged="SldCropTimeline_ValueChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="txtCropInfo" Grid.Row="3" Foreground="#AAAAAA" FontSize="11" TextAlignment="Center" Margin="0,6,0,0"/>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="CANCEL" Width="100" Height="35" Background="#333" Margin="0,0,10,0" Click="BtnCancelCrop_Click"/>
                        <Button Content="SAVE CROP" Width="150" Height="35" Background="#4A3D7A" BorderBrush="#9B84EC" FontWeight="Bold" Click="BtnSaveCrop_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- WATERMARK OVERLAY -->
        <Grid x:Name="gridWatermarkOverlay" Visibility="Collapsed" Background="#CC000000">
            <Border Background="#1A1A1E" Width="900" Height="600" CornerRadius="10" BorderBrush="#FF0055" BorderThickness="2">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="VISUAL EDITOR" FontSize="18" FontWeight="Bold" Foreground="#FF0055" HorizontalAlignment="Center"/>
                    <Border Grid.Row="1" BorderBrush="#444" BorderThickness="1" Background="Black" Margin="0,10" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Grid>
                                <Grid x:Name="gridPreviewContainer" Width="1920" Height="1080" Background="Black">
                                    <Image x:Name="imgWatermarkVideoFrame" Width="1920" Height="1080" Stretch="Fill"/>
                                </Grid>
                                <Canvas x:Name="cvsWatermarkPreview" Width="1920" Height="1080" Background="Transparent">
                                    <Image x:Name="imgWatermarkPreview" Width="150" Height="150" RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="ImgWatermark_MouseDown" MouseLeftButtonUp="ImgWatermark_MouseUp" MouseMove="ImgWatermark_MouseMove" Cursor="SizeAll">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="stWatermark"/>
                                                <RotateTransform x:Name="rtWatermark"/>
                                                <TranslateTransform x:Name="ttWatermark"/>
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                    </Image>
                                </Canvas>
                            </Grid>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Scale" Foreground="White"/>
                        <Slider x:Name="sldWmkScale" Minimum="0.1" Maximum="3.0" Value="1.0" ValueChanged="SldWmk_ValueChanged"/>
                        <TextBlock Text="Rotation" Foreground="White"/>
                        <Slider x:Name="sldWmkRotate" Minimum="-180" Maximum="180" Value="0" ValueChanged="SldWmk_ValueChanged"/>
                        <TextBlock Text="Opacity" Foreground="White"/>
                        <Slider x:Name="sldWmkOpacity" Minimum="0.1" Maximum="1.0" Value="1.0" ValueChanged="SldWmk_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="CANCEL" Width="100" Height="35" Background="#333" Margin="0,0,10,0" Click="BtnCancelWatermark_Click"/>
                        <Button Content="SAVE" Width="150" Height="35" Background="#FF0055" FontWeight="Bold" Click="BtnSaveWatermark_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
