<Window x:Class="TitanEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Titan Engine V193 UI+Soundbar Update" Height="920" Width="1280" FontFamily="Segoe UI"
        Foreground="White"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">

    <Window.Background>
        <SolidColorBrush Color="#0A0C10"/>
    </Window.Background>

    <Window.Resources>
        <!-- TITAN DESIGN SYSTEM v2 - modern dark (Linear/Raycast language).
             Neutral surface stack + ONE accent. Layout & handlers unchanged. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#4CC3FF"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#1F4258"/>
        <SolidColorBrush x:Key="CardBrush" Color="#11141A"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1E242E"/>
        <SolidColorBrush x:Key="InputBrush" Color="#161B22"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#262D38"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F4F8"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B95A5"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#5C6672"/>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#171B23"/>
            <Setter Property="Foreground" Value="#C9D2DE"/>
            <Setter Property="BorderBrush" Value="#2A3340"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A202A"/>
            <Setter Property="Foreground" Value="#F0F4F8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A3340"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#202836"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CC3FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#161B22"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1F4258"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E8EEF5"/>
            <Setter Property="CaretBrush" Value="#4CC3FF"/>
            <Setter Property="SelectionBrush" Value="#1F4258"/>
            <Setter Property="BorderBrush" Value="#262D38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CC3FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#334050"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDE5EE"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="4,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1F2733"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#1F4258"/>
                                <Setter Property="Foreground" Value="#4CC3FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5C6672"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E8EEF5"/>
            <Setter Property="BorderBrush" Value="#262D38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                            <ToggleButton x:Name="toggle" Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Path x:Name="arrow" Data="M0,0 L4.5,5 L9,0" Stroke="#8B95A5" StrokeThickness="1.6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#12161D" BorderBrush="#2A3340" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#334050"/>
                                <Setter TargetName="arrow" Property="Stroke" Value="#C9D2DE"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4CC3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C9D2DE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="17" Height="17" CornerRadius="4.5" Background="#161B22" BorderBrush="#2A3340" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="check" Data="M3.6,8.6 L7,12 L13.4,4.6" Stroke="#0A0C10" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="Background" Value="#4CC3FF"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#4CC3FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#4CC3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="#4CC3FF" Height="4" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderTrackEmpty" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="#242B36" Height="4" CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="15" Height="15" Fill="#E8EEF5" Stroke="#0A0C10" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" MinHeight="18">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackFill}" Command="{x:Static Slider.DecreaseLarge}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackEmpty}" Command="{x:Static Slider.IncreaseLarge}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" Background="#2E3642" CornerRadius="4" Margin="1.5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#435064"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#4CC3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="9"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#2E3642" CornerRadius="4" Margin="1.5"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#0D1014"/>
            <Setter Property="Foreground" Value="#4CC3FF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#1E242E"/>
            <Setter Property="Background" Value="#11141A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Grid.RowSpan="2" Background="#11141A" CornerRadius="10" BorderBrush="#1E242E" BorderThickness="1"/>
                            <Border Grid.Row="0" Grid.RowSpan="2" CornerRadius="10,10,0,0" BorderThickness="0,1,0,0" VerticalAlignment="Top" Height="14">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#26FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="17,12,0,4">
                                <Ellipse Width="6" Height="6" Fill="#4CC3FF" VerticalAlignment="Center" Margin="0,1,9,0"/>
                                <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.FontSize="12" TextElement.Foreground="#C9D2DE"/>
                            </StackPanel>
                            <ContentPresenter Grid.Row="1" Margin="16,7,16,16"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="itemRoot" Background="Transparent" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemRoot" Property="Background" Value="#141922"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemRoot" Property="Background" Value="#182029"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#232B36"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,6,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid Margin="25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="25"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                    <Border Width="4" Height="40" CornerRadius="2" Margin="0,0,15,0" Background="#4CC3FF"/>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="TITAN ENGINE" FontSize="25" FontWeight="Bold" Foreground="White"/>
                        <TextBlock FontSize="11" Foreground="#4CC3FF" Opacity="0.8" FontWeight="Bold"><Run Text="V193 UI+Soundbar Update"/></TextBlock>
                        <TextBlock FontSize="10" Foreground="#8B95A5" Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="520" Text="Changelog: + Hiệu ứng chữ Text Overlay (từ Caption Sync) | + Hiệu ứng Audio 1 Voice FX | + Thanh cường độ Audio FX | + Lọc file build GitHub | + Không xóa tính năng cũ"/>
                    </StackPanel>
                </StackPanel>

                <!-- SCROLLABLE CONTENT -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,10">
                    <StackPanel>
                        <!-- 1. SOURCE FILES -->
                        <GroupBox Header="SOURCE &amp; TRIM" Foreground="#4CC3FF" FontSize="13">
                            <StackPanel>
                                <TextBlock Text="Source Media (Video/Image)" Foreground="#8B95A5" FontSize="11" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtVideoPath" Grid.Column="0" IsReadOnly="True" Text="Drop Video/Image Here..." FontStyle="Italic" Opacity="0.5"/>
                                    <Button x:Name="btnBrowseVideo" Content="..." Grid.Column="1" Margin="8,0,0,0" Click="BtnBrowseVideo_Click"/>
                                </Grid>

                                <CheckBox x:Name="chkMergeVideos" Content="Merge Videos Into One Output (Concat)" Foreground="#8B95A5" Margin="0,-5,0,5" Checked="MergeOptionChanged" Unchecked="MergeOptionChanged"/>

                                <StackPanel Margin="0,0,0,10">
                                    <CheckBox x:Name="chkEnableCrossTransitions" Content="⚡ CapCut Cross-Clip Transitions" Foreground="#8B95A5" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <Grid Margin="15,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cmbCrossTransitionType" Grid.Column="0" Height="28" Padding="6,4,6,4" FontSize="11" Background="#161B22" Foreground="White" SelectedIndex="0">
                                            <ComboBoxItem Content="Dissolve"/>
                                            <ComboBoxItem Content="Fade (Black)"/>
                                            <ComboBoxItem Content="Fade (White)"/>
                                            <ComboBoxItem Content="Fade (Blur)"/>
                                            <ComboBoxItem Content="Fade (Opacity)"/>
                                            <ComboBoxItem Content="Whip Left"/>
                                            <ComboBoxItem Content="Whip Right"/>
                                            <ComboBoxItem Content="Whip Up"/>
                                            <ComboBoxItem Content="Whip Down"/>
                                            <ComboBoxItem Content="Zoom"/>
                                            <ComboBoxItem Content="Circle Crop"/>
                                            <ComboBoxItem Content="Radial Clock"/>
                                            <ComboBoxItem Content="Pixelize"/>
                                            <ComboBoxItem Content="Light Leak Burn"/>
                                            <ComboBoxItem Content="HBlur"/>
                                        </ComboBox>
                                        <TextBox x:Name="txtCrossTransitionDuration" Grid.Column="2" Text="0.6" Height="28" Padding="4,2,4,2" FontSize="12" FontWeight="Bold" Background="#161B22" Foreground="#4CC3FF" BorderBrush="#262D38" BorderThickness="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="Transition Duration in seconds (e.g. 0.6)"/>
                                    </Grid>
                                </StackPanel>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Start (00:00:00)" Foreground="#4CC3FF" FontSize="11"/>
                                        <TextBox x:Name="txtTrimStart" Text="00:00:00"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Duration" Foreground="#4CC3FF" FontSize="11"/>
                                        <TextBox x:Name="txtTrimDuration" ToolTip="Empty = Full"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Split Duration (sec)" Foreground="#4CC3FF" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="txtSplitDuration" ToolTip="Split rendered video into segments of this duration (seconds). Leave empty to skip splitting."/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="Image Timeline Duration (sec)" Foreground="#8B95A5" FontSize="11" Margin="0,0,0,5"/>
                                    <TextBox x:Name="txtImageTimelineDuration" ToolTip="Total duration shared across all selected image inputs. Leave empty to keep default per-image timing."/>
                                </StackPanel>

                                <TextBlock Text="Audio 1 (Opt)" Foreground="#8B95A5" FontSize="11" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtAudioPath" Grid.Column="0" IsReadOnly="True" Text="Select Audio 1..." FontStyle="Italic" Opacity="0.5"/>
                                    <Button x:Name="btnBrowseAudio" Content="..." Grid.Column="1" Margin="8,0,0,0" Click="BtnBrowseAudio_Click"/>
                                </Grid>
                                <TextBlock Text="Audio 2 (Overlay)" Foreground="#8B95A5" FontSize="11" Margin="0,10,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtAudioPath2" Grid.Column="0" IsReadOnly="True" Text="Select Audio 2..." FontStyle="Italic" Opacity="0.5"/>
                                    <Button x:Name="btnBrowseAudio2" Content="..." Grid.Column="1" Margin="8,0,0,0" Click="BtnBrowseAudio2_Click"/>
                                </Grid>
                                <CheckBox x:Name="chkMergeAudios" Content="Merge Audio Tracks Into One Output (Concat)" Foreground="#C9D2DE" Margin="0,8,0,0" Checked="MergeOptionChanged" Unchecked="MergeOptionChanged"/>
                                <Button x:Name="btnRandomCombos" Content="🎲 RANDOM VIDEO × AUDIO" Visibility="Collapsed" Background="#2A2110" BorderBrush="#4CC3FF" Foreground="#F2D27E" FontWeight="Bold" Margin="0,8,0,0" Height="44" Click="BtnRandomCombos_Click" ToolTip="Tạo mọi tổ hợp Video/Image × Audio thành nhiều queue, giữ nguyên toàn bộ setting hiện tại"/>
                                <Button x:Name="btnEditAudio" Content="EDIT AUDIO DURATIONS" Background="#241E38" BorderBrush="#8B7CF6" Margin="0,10,0,0" Click="BtnOpenAudioEditor_Click"/>
                                <TextBlock x:Name="txtAudioEditSummary" Text="No audio cuts applied" Foreground="#6B7480" FontSize="9" Margin="0,4,0,0"/>

                                <Grid Margin="0,12,0,5">
                                    <TextBlock Text="Added Audio Speed" Foreground="#C9D2DE" FontSize="11"/>
