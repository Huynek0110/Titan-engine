                                <ComboBox x:Name="cmbTextAnimation" Margin="0,0,0,8" ToolTip="Bộ hiệu ứng chữ được chuyển từ Caption Sync. Chọn 'Drawtext cũ' để dùng chế độ Typewriter + chạy trượt lên + Neon Glow như trước.">
